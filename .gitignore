# --- editors / python ---
.vscode
.idea
__pycache__
*.pyc
*.pyo
*.pyd
.DS_Store

# --- agent + tooling state, not part of the project ---
.omc/
.claude/

# --- training artefacts: large, regenerable, and machine-specific ---
ckpt_dir/
log/
log_dirs/
output/
# results/: keep the JSON and the raw per-sample arrays are dropped; the
# generated images are hundreds of MB and eval/run_eval.py regenerates them.
results/**/*.png
results/**/*.npz
results/figures/

# --- datasets and caches live outside the repo ---
config/data/
config/data_smoke/
config/data_overfit/

# --- LaTeX build products (the PDFs are committed, the intermediates are not) ---
papers/*.aux
papers/*.bbl
papers/*.blg
papers/*.log
papers/*.out
papers/*.toc

# --- misc ---
*.db
*.sqlite3
*.h5
*.npy
*.ckpt
*.pth

# --- internal peer review, kept local ---
ai_review/

# the SRMv2 form draft carries author names and affiliations; the anonymous
# supplementary mirrors this repository, so it stays out of the tree
papers/srmv2_form_draft.txt

# Author-drawn figure sources. The slide export carries `author: 이제영` in its
# PDF metadata, and the PNGs are its raster exports; this repository is what the
# anonymous supplementary mirrors, so none of them may be tracked. The figures
# the paper uses are the metadata-stripped crops in papers/figures/.
images/Frequency_Adapataion.pdf
images/Main.png
images/Main.PNG
images/SA-Adapter.PNG
images/SA-Aapter.PNG
